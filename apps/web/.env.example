# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
DATABASE_URL="file:./dev.db"
# String acak panjang untuk menandatangani sesi login (wajib diganti di production).
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# Akun admin awal yang dibuat oleh `npm run db:seed`. Ganti sandi setelah login pertama.
SEED_ADMIN_EMAIL="admin@dokteredukasi.test"
SEED_ADMIN_PASSWORD="ganti-sandi-admin"
# true = buat juga akun demo tutor & murid (hanya untuk lokal/staging).
SEED_DEMO="true"
SEED_DEMO_PASSWORD="ganti-sandi-demo"
# Batas ukuran unggahan berkas (MB).
MAX_UPLOAD_MB="50"
