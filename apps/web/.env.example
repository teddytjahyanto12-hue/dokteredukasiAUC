# Salin menjadi .env lalu isi nilainya. Jangan commit .env.
DATABASE_URL="file:./dev.db"
# String acak panjang untuk menandatangani sesi login (wajib diganti di production).
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# Akun admin awal yang dibuat oleh `npm run db:seed`. Ganti sandi setelah login pertama.
SEED_ADMIN_EMAIL="admin@dokteredukasi.test"
SEED_ADMIN_PASSWORD="ganti-sandi-admin"
# true = buat juga akun demo tutor & murid (hanya untuk lokal/staging).
SEED_DEMO="true"
SEED_DEMO_PASSWORD="ganti-sandi-demo"
# Batas ukuran unggahan berkas (MB).
MAX_UPLOAD_MB="50"
# Lokasi soffice (LibreOffice) untuk konversi PPTX → PDF. Kosongkan untuk deteksi otomatis.
SOFFICE_PATH=""
# Email (kwitansi & notifikasi). Kosongkan SMTP_HOST bila belum ada; email akan dicatat tanpa dikirim.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# Alamat website untuk tautan di email (ganti saat online).
APP_URL="http://localhost:3000"
# Rahasia pemicu laporan berkala lewat /api/cron/laporan (hanya perlu di hosting serverless).
CRON_SECRET=""
